{"nodes": [{"id": "openspec_changes_derive_store_column_order_design_store_column_order_design", "label": "Store Column Order Design", "file_type": "document", "source_file": "openspec/changes/derive-store-column-order/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "openspec_changes_derive_store_column_order_design_storage_owned_column_definition", "label": "Storage-Owned Column Definition", "file_type": "concept", "source_file": "openspec/changes/derive-store-column-order/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SQLite column definitions remain in store because driver-shaped storage details must not enter domain models."}, {"id": "openspec_changes_derive_store_column_order_design_single_column_order_declaration", "label": "Single Column Order Declaration", "file_type": "concept", "source_file": "openspec/changes/derive-store-column-order/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An explicit ordered tuple makes order intentional and avoids coupling storage layout to reflected domain dataclass internals."}, {"id": "openspec_changes_derive_store_column_order_design_nullability_and_key_style_fidelity", "label": "Nullability and Primary-Key Style Fidelity", "file_type": "concept", "source_file": "openspec/changes/derive-store-column-order/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Normalizing key declarations would change SQLite null enforcement, violating the behavior-preserving constraint."}, {"id": "openspec_changes_derive_store_column_order_design_generated_sql_enumerations", "label": "Generated SQL Column Enumerations", "file_type": "concept", "source_file": "openspec/changes/derive-store-column-order/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only mechanical column lists are generated; meaningful SQL skeletons and the staleness predicate remain literal and greppable."}, {"id": "openspec_changes_derive_store_column_order_design_name_keyed_extractor_map", "label": "Name-Keyed Row Extractor Map", "file_type": "concept", "source_file": "openspec/changes/derive-store-column-order/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Walking one declaration for both SQL and values removes positional drift; a key-set equality test makes missing extractors fail loudly."}, {"id": "openspec_changes_derive_store_column_order_design_sqlite_row_named_reads", "label": "sqlite3.Row Name-Keyed Reads", "file_type": "concept", "source_file": "openspec/changes/derive-store-column-order/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Named access removes read dependence on column position while keeping sqlite3.Row confined to store."}, {"id": "openspec_changes_derive_store_column_order_design_behavior_preserving_no_migration", "label": "Behavior-Preserving Refactor With No Migration", "file_type": "concept", "source_file": "openspec/changes/derive-store-column-order/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The emitted schema and on-disk representation remain unchanged, so old and new code can read each other's stores and rollback needs no data step."}, {"id": "openspec_changes_derive_store_column_order_design_adr_0001_and_0002_storage_boundary", "label": "ADR 0001 and ADR 0002 Storage Boundary", "file_type": "concept", "source_file": "openspec/changes/derive-store-column-order/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},